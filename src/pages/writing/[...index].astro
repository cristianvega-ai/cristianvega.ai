---
import DetailLayout from "../../layouts/DetailLayout.astro";
import EntryList from "../../components/sections/EntryList.astro";
import { articleDayAndMonth, articleRow, articleYear, getArticles } from "../../shared/content/writing";

// Build /writing/ only when an article is visible. Production has no published
// article yet, so the route must not exist. Dev shows drafts and builds the route.
export async function getStaticPaths() {
  return (await getArticles()).length > 0 ? [{ params: { index: undefined } }] : [];
}

const articles = await getArticles();
const hasDrafts = articles.some((article) => article.data.draft);
// Newest year first. getArticles already sorts the articles newest first.
const years = [...new Set(articles.map(articleYear))].map((year) => ({
  year,
  rows: articles.filter((article) => articleYear(article) === year).map((article) => articleRow(article, articleDayAndMonth(article))),
}));
const description = "Notes on production AI, engineering, and the systems around them.";
---

<DetailLayout title="Writing" {description} lede={description} active="writing" backHref="/" backLabel="Home" noindex={hasDrafts}>
  {years.map(({ year, rows }) => (
    <section class="detail__section" aria-labelledby={`writing-${year}`}>
      <h2 class="detail__section-label" id={`writing-${year}`}>{year}</h2>
      <EntryList rows={rows} />
    </section>
  ))}
</DetailLayout>
