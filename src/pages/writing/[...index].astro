---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageGraphic from "../../components/PageGraphic.astro";
import { getArticles, articleDate, articleUrl, readingMinutes } from "../../shared/writing";
import "../../styles/writing.css";

// Build /writing/ only when an article is visible. Production has no published
// article yet, so the route must not exist. Dev shows drafts and builds the route.
export async function getStaticPaths() {
  return (await getArticles()).length > 0 ? [{ params: { index: undefined } }] : [];
}

const articles = await getArticles();
const hasDrafts = articles.some((article) => article.data.draft);
---

<BaseLayout title="Writing" description="Notes on production AI, engineering, and the systems around them." active="writing" noindex={hasDrafts}>
  <main class="writing-index" data-writing-page>
    <PageGraphic page="writing" />
    <div class="writing-index__intro">
      <p class="eyebrow">Notes · Essays</p>
      <h1 id="writing-title">Writing</h1>
      <p class="writing-index__count">{String(articles.length).padStart(2, "0")} {articles.length === 1 ? "post" : "posts"}{hasDrafts && " · local preview"}</p>
    </div>
    <section class="writing-index__list" data-writing-list aria-labelledby="writing-title">
      <ol class="article-list">
        {articles.map((article, index) => (
          <li class="article-list__item" data-article-id={article.id} data-writing-entry-id={article.id}>
            <span class="article-list__num" data-writing-label aria-hidden="true">N° {String(articles.length - index).padStart(2, "0")}</span>
            <h2 class="article-list__title"><a class="article-list__link" href={articleUrl(article)}>{article.data.title}</a></h2>
            <p class="article-list__meta"><time datetime={article.data.date.toISOString().slice(0, 10)}>{articleDate(article)}</time> · {article.data.topic} · {readingMinutes(article)} min{article.data.draft && <span class="draft-label"> · Draft</span>}</p>
            <p class="article-list__excerpt">{article.data.description}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

