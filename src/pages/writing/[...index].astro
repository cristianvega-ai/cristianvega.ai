---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import PageGraphic from "../../components/PageGraphic.astro";
import { getArticles } from "../../shared/content/writing";
import "../../styles/writing-index.css";

// Build /writing/ only when an article is visible. Production has no published
// article yet, so the route must not exist. Dev shows drafts and builds the route.
export async function getStaticPaths() {
  return (await getArticles()).length > 0 ? [{ params: { index: undefined } }] : [];
}

const articles = await getArticles();
const hasDrafts = articles.some((article) => article.data.draft);
---

<BaseLayout title="Writing" description="Notes on production AI, engineering, and the systems around them." active="writing" noindex={hasDrafts}>
  <main class="writing-index" data-writing-page>
    <PageGraphic page="writing" />
    <div class="writing-index__introduction">
      <p class="eyebrow">Notes · Essays</p>
      <h1 id="writing-title">Writing</h1>
      <p class="writing-index__count">{String(articles.length).padStart(2, "0")} {articles.length === 1 ? "article" : "articles"}{hasDrafts && " · local preview"}</p>
    </div>
    <section class="writing-index__list" data-writing-list aria-labelledby="writing-title">
      <ArticleList {articles} />
    </section>
  </main>
</BaseLayout>

