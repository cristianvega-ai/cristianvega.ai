---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticles } from "../../shared/content/writing";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, articleIndex) => ({
    params: { slug: article.id },
    props: { article, older: articles[articleIndex + 1], newer: articles[articleIndex - 1] },
  }));
}

const { article, older, newer } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout {article} {older} {newer}>
  <Content />
</ArticleLayout>
