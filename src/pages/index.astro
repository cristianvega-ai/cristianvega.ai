---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroMotion from "../components/HeroMotion.astro";
---

<BaseLayout active="home" bare>
  <main>
    <section class="hero">
      <div class="hero__grid">
        <HeroMotion />
        <div class="hero__portrait-col"></div>
        <div class="hero__main">
          <p class="eyebrow hero__eyebrow" data-motion-target="eyebrow">AI Engineering Leader · Agentic&nbsp;Systems</p>
          <h1 class="hero__name">
            <span data-motion-target="name">Cristian </span><span class="hl" data-motion-target="highlight">Vega</span>
          </h1>
          <p class="hero__sub" data-motion-target="subhead">I build agentic AI where mistakes are expensive — and lead the teams that ship it.</p>
          <div class="hero__actions">
            <a class="btn btn--signal" data-motion-target="primary-action" href="/projects/">See what I've built</a>
            <a class="btn btn--ghost" data-motion-target="secondary-action" href="/writing/">Read the writing</a>
          </div>
        </div>
      </div>
      <div class="hero__ticker">
        <div class="wrap">
          <span><b>45</b> engineers · 100 at peak</span>
          <span><b>10 yrs</b> shipping · 5 leading AI/ML</span>
          <span><b>insurance &amp; banking</b> · regulated by default</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
