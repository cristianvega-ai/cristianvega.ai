---
import BaseLayout from "../layouts/BaseLayout.astro";
import Identity from "../components/identity/Identity.astro";
import ProfileLinks from "../components/identity/ProfileLinks.astro";
import HomeSection from "../components/sections/HomeSection.astro";
import RowPreview from "../components/lab/RowPreview.astro";
import { experimentRow, getExperiments } from "../shared/content/lab";
import { selectLatestEntries } from "../shared/content/latest-entries";
import { getProducts, productRow } from "../shared/content/products";
import { articleRow, getArticles } from "../shared/content/writing";
import "../styles/home.css";

// Each section shows its newest entries and links to its own page. A section
// with nothing visible does not render, so the page never points at a route
// the build does not emit.
const products = selectLatestEntries(await getProducts()).map(productRow);
const experiments = selectLatestEntries(await getExperiments()).map(experimentRow);
const articles = selectLatestEntries(await getArticles()).map((article) => articleRow(article));
---

<BaseLayout active="home">
  <Identity />

  <p class="bio enter" data-step="2">
    <em>I build AI systems and lead the teams that bring them to life.</em> I’ve spent the last ten years in
    software engineering, with the last five focused on putting AI into production. What interests me most
    is figuring out what these models can actually do, where they fall short, and how to turn that
    understanding into reliable systems. I spend a lot of my time experimenting with models, building agents,
    and solving the engineering problems that come with making AI work in the real world.
  </p>

  <ProfileLinks step={3} />

  {products.length > 0 && <HomeSection label="Products" id="products-label" rows={products} allHref="/products/" allLabel="All products" step={4} />}
  {experiments.length > 0 && <HomeSection label="Lab" id="lab-label" rows={experiments} allHref="/lab/" allLabel="All experiments" step={5} />}
  {experiments.length > 0 && <RowPreview />}
  {articles.length > 0 && <HomeSection label="Writing" id="writing-label" rows={articles} allHref="/writing/" allLabel="All writing" step={6} />}
</BaseLayout>
