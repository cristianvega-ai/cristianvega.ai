---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroMotion from "../components/HeroMotion.astro";
---

<BaseLayout active="home">
  <main>
    <section class="hero">
      <div class="hero__grid">
        <HeroMotion />
        <div class="hero__portrait-col"></div>
        <div class="hero__main">
          <p class="eyebrow hero__eyebrow" data-motion-target="eyebrow">AI Engineering Leader · Agentic&nbsp;Systems</p>
          <h1 class="hero__name">
            <span data-motion-target="name">Cristian </span><span class="highlight" data-motion-target="highlight">Vega</span>
          </h1>
          <p class="hero__sub" data-motion-target="subhead">I build agentic AI where mistakes are expensive, and lead the teams that ship it.</p>
          <div class="hero__actions">
            <a class="button button--signal" data-motion-target="primary-action" href="/contact/">Get in touch</a>
            <a class="button button--ghost" data-motion-target="secondary-action" href="/about/">Read the background</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
