---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Cristian Vega about consulting on applied AI, collaborations, or building something together."
  active="contact"
>
  <main>
    <section class="section section--tight page-head dotgrid">
      <div class="wrap wrap--narrow">
        <p class="marker"><span class="marker__sig">§</span> Contact</p>
        <h1 class="page-title">Let's <span class="hl">build</span> something.</h1>
        <p class="page-lede">
          Best for consulting on applied AI, collaborations, or comparing notes on shipping AI in production. I read everything.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="wrap wrap--narrow">
        <ul class="contact-grid">
          <li>
            <a class="contact-card" href="mailto:hello@cristianvega.ai">
              <span class="eyebrow">Email</span>
              <span class="contact-card__value">hello@cristianvega.ai</span>
              <span class="contact-card__note">I use this for consulting work and long questions.</span>
            </a>
          </li>
          <li>
            <a
              class="contact-card"
              href="https://www.linkedin.com/in/cristianvega-ai"
              rel="me noopener noreferrer"
              target="_blank"
            >
              <span class="eyebrow">LinkedIn</span>
              <span class="contact-card__value">/in/cristianvega-ai</span>
              <span class="contact-card__note">I use this for introductions and my work history.</span>
            </a>
          </li>
          <li>
            <a
              class="contact-card"
              href="https://github.com/cristianvega-ai"
              rel="me noopener noreferrer"
              target="_blank"
            >
              <span class="eyebrow">GitHub</span>
              <span class="contact-card__value">@cristianvega-ai</span>
              <span class="contact-card__note">I put my public code and experiments here.</span>
            </a>
          </li>
          <li>
            <a
              class="contact-card"
              href="https://x.com/cristianvega"
              rel="me noopener noreferrer"
              target="_blank"
            >
              <span class="eyebrow">X</span>
              <span class="contact-card__value">@cristianvega</span>
              <span class="contact-card__note">I post short notes on AI engineering here.</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
