---
import DetailLayout from "../../layouts/DetailLayout.astro";
import EntryList from "../../components/sections/EntryList.astro";
import { getProducts, productRow } from "../../shared/content/products";

// Build /products/ only when a product is visible. With no visible product the route must not exist.
export async function getStaticPaths() {
  return (await getProducts()).length > 0 ? [{ params: { index: undefined } }] : [];
}

const products = await getProducts();
const hasDrafts = products.some((product) => product.data.draft);
const description = "Products I have built.";
---

<DetailLayout title="Products" {description} lede={description} active="products" backHref="/" backLabel="Home" noindex={hasDrafts}>
  <EntryList rows={products.map(productRow)} />
</DetailLayout>
