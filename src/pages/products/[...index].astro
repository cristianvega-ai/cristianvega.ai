---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageGraphic from "../../components/PageGraphic.astro";
import ProductList from "../../components/ProductList.astro";
import { getProducts } from "../../shared/products";
import { assertProductCapacity } from "../../shared/page-graphics/scenes/product-slots";
import "../../styles/reading-column.css";
import "../../styles/products.css";

// Build /products/ only when a product is visible. With no visible product the route must not exist.
export async function getStaticPaths() {
  const products = await getProducts();
  assertProductCapacity(products.filter(({ data }) => !data.draft).length);
  return products.length > 0 ? [{ params: { index: undefined } }] : [];
}

const products = await getProducts();
const hasDrafts = products.some((entry) => entry.data.draft);
---

<BaseLayout title="Products" description="Products I have built." active="products" noindex={hasDrafts}>
  <main>
    <PageGraphic page="products" productCount={products.length} currentProductIndex={null} />
    <section class="product product--index" aria-labelledby="products-title">
      <header class="product__header wrap wrap--read">
        <p class="eyebrow">Products{hasDrafts && <span class="draft-label"> · Local preview</span>}</p>
        <h1 id="products-title" class="product__title">Products</h1>
      </header>
      <div class="product__body wrap wrap--read">
        <ProductList products={products} />
      </div>
    </section>
  </main>
</BaseLayout>
