---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageGraphic from "../components/PageGraphic.astro";
import "../styles/reading-column.css";
import "../styles/missing-page.css";
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist on cristianvega.ai."
  active="error"
  noindex
>
  <main>
    <PageGraphic page="404" />
    <section class="missing-page" aria-labelledby="not-found-title">
      <div class="missing-page__header wrap wrap--read">
        <p class="eyebrow">§ 404</p>
        <h1 id="not-found-title" class="missing-page__title">This page doesn't exist.</h1>
        <p class="missing-page__lede">
          The link may be outdated, or the URL might be mistyped. Head back to the home page.
        </p>
        <p class="missing-page__actions"><a class="button button--signal" href="/">Home</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
