---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css";
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist on cristianvega.ai."
  active="error"
  noindex
>
  <main>
    <section class="about" aria-labelledby="not-found-title">
      <div class="about__head wrap wrap--read">
        <p class="eyebrow">§ 404</p>
        <h1 id="not-found-title" class="about__title">This page doesn't exist.</h1>
        <p class="about__lede">
          The link may be outdated, or the URL might be mistyped. Head back to the home page.
        </p>
        <p class="about__actions"><a class="btn btn--signal" href="/">Home</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
