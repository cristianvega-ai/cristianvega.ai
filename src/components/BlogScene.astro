---
interface Props {
  inputs: string[];
}

const { inputs } = Astro.props;
---

<div class="lyra-scene lyra-scene--index" data-lyra data-inputs={JSON.stringify(inputs)} aria-hidden="true">
  <canvas class="lyra-scene__canvas"></canvas>
  <div class="lyra-scene__scan"></div>
  <p class="lyra-scene__hud cut">
    <span>Lyra · {inputs.length || 8} → 16 → 5 → 1</span>
    <span>Vega · <span class="lyra-scene__symbol">α</span> Lyr · output</span>
  </p>
  <div class="lyra-scene__card cut"><p data-scene-title></p><span data-scene-meta></span></div>
</div>

<script>
  import { setupBlogMotion } from "../lib/blog-motion/setup";

  let cleanup = setupBlogMotion();
  window.addEventListener("pagehide", () => cleanup());
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) cleanup = setupBlogMotion();
  });
</script>
