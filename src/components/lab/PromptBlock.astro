---
// The prompt of an experiment, exactly as the models received it.
import "../../styles/prompt-block.css";

interface Props {
  prompt: string;
}

const { prompt } = Astro.props;
---

<section class="prompt-block" aria-labelledby="prompt-label">
  <h2 class="detail__section-label" id="prompt-label">Prompt</h2>
  <p class="prompt-block__text">{prompt.trim()}</p>
</section>
