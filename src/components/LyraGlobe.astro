---
import LyraGlobeArt from "./LyraGlobeArt.astro";
import { buildGlobe, GLOBE_HEIGHT, GLOBE_WIDTH } from "../shared/lyra-globe/model";

// The canvas draws the globe and its entrance, so the page shows no SVG while
// the script works. The SVG is the same picture for the two cases with no
// canvas: a noscript for visitors without JavaScript, and a template that the
// script copies in when canvas is missing or its setup fails.
// The page links globeProjectionHref (src/shared/lyra-globe/projection.ts) in its head.
const globe = buildGlobe();
---

<div class="lyra-globe" data-lyra-globe aria-hidden="true">
  <noscript><LyraGlobeArt globe={globe} /></noscript>
  <template><LyraGlobeArt globe={globe} /></template>
  <canvas class="lyra-globe__canvas"></canvas>
  {/* The labels sit on the globe grid but keep a fixed size in CSS pixels. Their own svg has no viewBox, so the grid scale never shrinks the type. */}
  <svg class="lyra-globe__labels" focusable="false">
    {globe.labels.map((label) => <text class:list={["lyra-globe__label", { "lyra-globe__label--caption": label.align === "center" }]} x={`${((label.x / GLOBE_WIDTH) * 100).toFixed(3)}%`} y={`${((label.y / GLOBE_HEIGHT) * 100).toFixed(3)}%`} dx={label.dx} dy={label.dy} text-anchor={label.align === "center" ? "middle" : "start"} opacity={label.alpha}>{label.text}</text>)}
  </svg>
</div>

<script>
  import { setupLyraGlobe } from "../shared/lyra-globe/motion";

  setupLyraGlobe();
</script>
