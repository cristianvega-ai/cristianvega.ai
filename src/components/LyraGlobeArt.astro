---
import { GLOBE_HEIGHT, GLOBE_WIDTH, type Globe } from "../shared/lyra-globe/model";
import { HOT_EDGE_ALPHA, NODE_HALO, VEGA_HALO, VEGA_RING_ALPHA, VEGA_RING_RADIUS } from "../shared/canvas/marks";
import { GLOW_CENTER_ALPHA } from "../shared/canvas/palette";

interface Props {
  globe: Globe;
}

const { globe } = Astro.props;
const edgePath = (edge: Globe["edges"][number]) =>
  `M${edge.first.x.toFixed(2)},${edge.first.y.toFixed(2)}L${edge.second.x.toFixed(2)},${edge.second.y.toFixed(2)}`;
---

<svg class="lyra-globe__fallback" viewBox={`0 0 ${GLOBE_WIDTH} ${GLOBE_HEIGHT}`} focusable="false">
  <defs>
    <radialGradient id="lyra-globe-glow">
      <stop offset="0" stop-color="var(--sky)" stop-opacity={GLOW_CENTER_ALPHA} />
      <stop offset="1" stop-color="var(--sky)" stop-opacity="0" />
    </radialGradient>
  </defs>
  {globe.stars.map((star) => (
    <circle
      class="lyra-globe__star"
      cx={star.x.toFixed(2)}
      cy={star.y.toFixed(2)}
      r={star.radius.toFixed(2)}
      opacity={star.alpha.toFixed(3)}
    />
  ))}
  {globe.rings.map((ring) => (
    <ellipse
      class="lyra-globe__ring"
      cx={ring.x}
      cy={ring.y}
      rx={ring.radiusX}
      ry={ring.radiusY}
      transform={`rotate(${((ring.rotation * 180) / Math.PI).toFixed(2)} ${ring.x} ${ring.y})`}
      opacity={ring.alpha}
    />
  ))}
  {globe.edges.map((edge) => (
    <path
      class:list={["lyra-globe__edge", { "is-hot": edge.hot }]}
      d={edgePath(edge)}
      opacity={edge.hot ? HOT_EDGE_ALPHA : edge.alpha.toFixed(3)}
    />
  ))}
  {globe.nodes.map((node) => <>
    {node.hot && (
      <circle
        cx={node.x.toFixed(2)}
        cy={node.y.toFixed(2)}
        r={node.vega ? VEGA_HALO : NODE_HALO}
        fill="url(#lyra-globe-glow)"
      />
    )}
    <circle
      class:list={["lyra-globe__node", { "is-hot": node.hot }]}
      cx={node.x.toFixed(2)}
      cy={node.y.toFixed(2)}
      r={node.radius}
      opacity={node.alpha.toFixed(3)}
    />
    {node.vega && (
      <circle
        class="lyra-globe__ring"
        cx={node.x.toFixed(2)}
        cy={node.y.toFixed(2)}
        r={VEGA_RING_RADIUS}
        opacity={VEGA_RING_ALPHA}
      />
    )}
  </>)}
</svg>
