---
// The decorative graphic of an inner page. It is a canvas that one bundled
// script fills. Without JavaScript the box takes no space, and the faint grid
// stays. Place it as the first child of <main>. Placement is in global.css.
type Props =
  | {
      page: "products";
      productCount: number;
      /** The index page passes null. A detail page passes its product index. */
      currentProductIndex: number | null;
    }
  | {
      page: "about" | "404" | "writing";
      productCount?: never;
      currentProductIndex?: never;
    };

const props = Astro.props;
---

<div
  class="page-graphic"
  data-graphic={props.page}
  data-products={props.page === "products" ? props.productCount : undefined}
  data-current={props.page === "products" ? props.currentProductIndex ?? undefined : undefined}
  aria-hidden="true"
>
  <canvas class="page-graphic__canvas"></canvas>
</div>

<script>
  import { mountPageGraphic } from "../lib/page-graphics/scenes/index.ts";

  // The module tears down on pagehide and sets up again on a restored page.
  const root = document.querySelector<HTMLElement>("[data-graphic]");
  if (root) void mountPageGraphic(root);
</script>
