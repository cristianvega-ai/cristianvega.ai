---
import { productAddress, type Product } from "../shared/content/products";
import "../styles/entries.css";
import "../styles/product-list.css";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<ol class="entries">
  {products.map((product) => (
    <li class="entries__item" data-product-identifier={product.id}>
      <p class="entries__metadata">
        <span>{product.data.status ?? "Product"}</span>
        {product.data.draft && <span class="draft-label">Draft</span>}
      </p>
      <div>
        <h2 class="entries__title"><a class="entries__link" href={productAddress(product)}>{product.data.title}</a></h2>
        <p class="entries__excerpt">{product.data.description}</p>
      </div>
    </li>
  ))}
</ol>
