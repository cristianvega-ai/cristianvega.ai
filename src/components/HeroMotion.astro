---
// Canvas is decorative; the real hero copy and anchors remain in index.astro.
---

<div class="hero-motion" data-hero-motion aria-hidden="true">
  <canvas class="hero__portrait-canvas"></canvas>
  <canvas class="hero__copy-canvas"></canvas>
</div>

<script>
  import { setup } from "../lib/hero-motion/setup";

  document.addEventListener("astro:page-load", () => {
    void setup();
  });
</script>
