---
// The owner's eyebrow and name. The homepage and the about page open with it.
import { JOB_TITLE } from "../shared/site";

interface Props {
  /** The id of the h1. The page section names itself by it. */
  titleIdentifier: string;
  titleClass: string;
}

const { titleIdentifier, titleClass } = Astro.props;
---

<p class="eyebrow eyebrow--parts"><span class="eyebrow__part">{JOB_TITLE}</span> <span class="eyebrow__part">Agentic&nbsp;Systems</span></p>
<h1 id={titleIdentifier} class={titleClass}>Cristian <span class="highlight">Vega</span></h1>
