---
// The page of one product: the detail frame, its prose, and its link out.
import DetailLayout from "./DetailLayout.astro";
import { productMorphKey, type Product } from "../shared/content/products";
import "../styles/prose.css";
import "../styles/product.css";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { title, description, status, url, draft } = product.data;
---

<DetailLayout
  {title}
  {description}
  lede={description}
  active="product"
  backHref="/products/"
  backLabel="Products"
  morphKey={productMorphKey(product)}
  noindex={draft}
  {draft}
  landmark="article"
>
  <Fragment slot="meta">{status ?? "Product"}</Fragment>
  <div class="prose"><slot /></div>
  {url && (
    <p class="product__links">
      <a class="product__link" href={url} target="_blank" rel="noopener noreferrer">Visit {title} ↗</a>
    </p>
  )}
</DetailLayout>
