---
// The page of one Lab experiment: the detail frame, the write-up, then the
// prompt and every result with its clip, so the reader meets the findings
// first and the evidence after. The principles it names close the page.
import DetailLayout from "./DetailLayout.astro";
import ClipPauseButton from "../components/lab/ClipPauseButton.astro";
import EntryList from "../components/sections/EntryList.astro";
import PromptBlock from "../components/lab/PromptBlock.astro";
import ResultTile from "../components/lab/ResultTile.astro";
import { experimentDate, experimentMeta, experimentMorphKey, isGroup, type Experiment } from "../shared/content/lab";
import { getPrinciples, namedPrinciples, principleRow } from "../shared/content/principles";
import "../styles/prose.css";
import "../styles/result-tile.css";

interface Props {
  experiment: Experiment;
}

const { experiment } = Astro.props;
const { title, description, date, draft, prompt, note, results, principles } = experiment.data;
const principleRows = namedPrinciples(principles, await getPrinciples()).map(principleRow);
---

<DetailLayout
  {title}
  {description}
  lede={description}
  active="experiment"
  backHref="/lab/"
  backLabel="Lab"
  morphKey={experimentMorphKey(experiment)}
  noindex={draft}
  {draft}
  landmark="article"
>
  {/* A return from a live scene scrolls to its result before the first render. */}
  <link slot="head" rel="expect" href="#results" blocking="render" />
  <Fragment slot="meta">
    <time datetime={date.toISOString().slice(0, 10)}>{experimentDate(experiment)}</time>
    <span>{experimentMeta(experiment)}</span>
  </Fragment>

  <div class="prose"><slot /></div>

  <PromptBlock {prompt} />

  <section class="results" aria-labelledby="results-label">
    <div class="results__head">
      <h2 class="detail__section-label" id="results-label">{isGroup(experiment) ? "Results" : "Result"}</h2>
      <ClipPauseButton />
    </div>
    <ul class:list={["results__grid", !isGroup(experiment) && "results__grid--single"]} id="results">
      {results.map((result) => <li><ResultTile experiment={experiment.id} {result} /></li>)}
    </ul>
    {note && <p class="results__note">{note} Select a result to run it live.</p>}
  </section>

  {principleRows.length > 0 && (
    <section class="detail__section" aria-labelledby="experiment-principles">
      <h2 class="detail__section-label" id="experiment-principles">Principles in this experiment</h2>
      <EntryList rows={principleRows} />
    </section>
  )}
</DetailLayout>
