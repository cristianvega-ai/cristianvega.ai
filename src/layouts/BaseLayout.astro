---
// The frame of every page: the head, the header, the main content, and the footer.
import "../styles/global.css";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { JOB_TITLE, SITE_NAME, type PageKind } from "../shared/site";

interface Props {
  title?: string;
  description?: string;
  active?: PageKind;
  noindex?: boolean;
  published?: string;
}

const {
  title = `${SITE_NAME} · ${JOB_TITLE}`,
  description = "AI engineering leader building agentic AI and multi-agent platforms for regulated domains, and the engineering organizations that ship them.",
  active = "home",
  noindex = false,
  published,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {title} {description} {active} {noindex} {published} />
    {/* A page adds its own head elements here, such as the generated globe stylesheet. */}
    <slot name="head" />
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader {active} />

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    <SiteFooter />
    <CloudflareAnalytics />
  </body>
</html>
