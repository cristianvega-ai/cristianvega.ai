---
import "../styles/global.css";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import { getPosts } from "../lib/blog";
import { getProducts } from "../lib/products";
import plexSans400 from "../assets/fonts/ibm-plex-sans-latin-400.woff2?url";
import geist from "../assets/fonts/geist-latin-600.woff2?url";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "about" | "blog" | "post" | "products" | "product" | "error";
  noindex?: boolean;
  published?: string;
}

const {
  title = "Cristian Vega · AI Engineering Leader",
  description = "AI engineering leader building agentic AI and multi-agent platforms for regulated domains, and the engineering organizations that ship them.",
  active = "home",
  noindex = false,
  published,
} = Astro.props;

const buildYear = new Date().getFullYear();
const pageTitle = title.includes("Cristian Vega") ? title : `${title} · Cristian Vega`;
const siteOrigin = Astro.site ?? new URL("https://cristianvega.ai");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
// Writing shows when a post is visible. The writing pages keep their own link.
const showWriting = active === "blog" || active === "post" || (await getPosts()).length > 0;
// Products show the same way: the link appears when a product is visible.
const showProducts = active === "products" || active === "product" || (await getProducts()).length > 0;
const internalLinks: { label: string; href: string; current?: "page" | "location" }[] = [
  { label: "about", href: "/about/", current: active === "about" ? ("page" as const) : undefined },
  ...(showWriting
    ? [{ label: "writing", href: "/writing/", current: active === "blog" ? ("page" as const) : active === "post" ? ("location" as const) : undefined }]
    : []),
  ...(showProducts
    ? [{ label: "products", href: "/products/", current: active === "products" ? ("page" as const) : active === "product" ? ("location" as const) : undefined }]
    : []),
];
const profileLinks = [
  { label: "linkedin", href: "https://www.linkedin.com/in/cristianvega-ai" },
  { label: "x", href: "https://x.com/cristianvega" },
  { label: "github", href: "https://github.com/cristianvega-ai" },
];
const themeColor = "#14181F";
// Dedicated 1200×630 share card (see scripts/generate-portrait.mjs); not the square master.
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageUrl = new URL("/images/cristian-vega-og.jpg", siteOrigin).toString();
const ogImageAlt = "Portrait of Cristian Vega";
const siteName = "Cristian Vega";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin.origin}/#website`,
      url: `${siteOrigin.origin}/`,
      name: siteName,
      inLanguage: "en",
      publisher: { "@id": `${siteOrigin.origin}/#person` }
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin.origin}/#person`,
      name: siteName,
      url: `${siteOrigin.origin}/`,
      jobTitle: "AI Engineering Leader",
      worksFor: { "@type": "Organization", name: "Vertafore" },
      sameAs: profileLinks.map((link) => link.href)
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={active === "post" ? "article" : "website"} />
    {published && <meta property="article:published_time" content={published} />}
    {active === "post" && <meta name="author" content={siteName} />}
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* Preload only the faces measurement showed on the critical path: IBM
        Plex Sans 400 roman is the homepage LCP (intro copy), Geist 600 is
        the display heading. Mono 400/500/600 and Plex Sans 400 italic paint
        later and are left to CSS discovery. crossorigin is required for font
        preloads. */}
    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Cristian Vega home">
          <span class="brand__mark" aria-hidden="true"><i></i><i></i></span>
          <span class="brand__word"><i>Cristian</i>Vega</span>
        </a>

        <nav class="nav" aria-label="Primary">
          {internalLinks.map((link, index) => (
            <a class={index === internalLinks.length - 1 ? "nav__link nav__link--divided" : "nav__link"} href={link.href} aria-current={link.current}>{link.label}</a>
          ))}
          {profileLinks.map((link) => (
            <a class="nav__link" href={link.href} rel="me noopener noreferrer" target="_blank">{link.label}</a>
          ))}
        </nav>

        <details class="nav-menu">
          <summary class="nav-menu__toggle">menu</summary>
          <nav class="nav-menu__panel" aria-label="Menu">
            {internalLinks.map((link) => (
              <a class="nav-menu__link" href={link.href} aria-current={link.current}>{link.label}</a>
            ))}
            <div class="nav-menu__rule" role="presentation"></div>
            {profileLinks.map((link) => (
              <a class="nav-menu__link" href={link.href} rel="me noopener noreferrer" target="_blank">{link.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="site-footer__disclaimer">
          Disclaimer: The views and opinions expressed on this site are my own.
        </p>
        <p class="site-footer__copyright">© Copyright {buildYear} Cristian Vega</p>
      </div>
    </footer>
    <CloudflareAnalytics />
    <script>
      // The menu closes on Escape, when focus leaves it, and on a click
      // outside it. It still opens and closes without this script.
      const menu = document.querySelector<HTMLDetailsElement>(".nav-menu");
      menu?.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        menu.open = false;
        menu.querySelector("summary")?.focus();
      });
      // A press on the panel padding moves focus to nothing, so it is not a focus exit.
      // A Tab past the last link on a page with nothing after the menu also moves focus
      // to nothing, and it must close the menu.
      let pressing = false;
      menu?.addEventListener("pointerdown", () => { pressing = true; });
      document.addEventListener("pointerup", () => { pressing = false; });
      document.addEventListener("pointercancel", () => { pressing = false; });
      menu?.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;
        if (!menu.open || (next instanceof Node && menu.contains(next))) return;
        if (next === null && pressing) return;
        menu.open = false;
      });
      document.addEventListener("pointerdown", (event) => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
    </script>
  </body>
</html>
