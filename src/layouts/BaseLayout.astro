---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "writing" | "projects" | "about" | "contact" | "error";
  bare?: boolean;
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = "Cristian Vega — Senior Director, AI Engineering",
  description = "Head of AI R&D at Patra Corporation. Engineering leader building production AI for insurance, from NLP models to agentic autonomous workflows.",
  active = "home",
  bare = false,
  noindex = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title.includes("Cristian Vega") ? title : `${title} — Cristian Vega`;
const siteOrigin = Astro.site ?? new URL("https://cristianvega.ai");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
// Dedicated 1200×630 share card (see scripts/generate-portrait.mjs); not the square master.
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageUrl = new URL("/images/cristian-vega-og.jpg", siteOrigin).toString();
const ogImageAlt = "Portrait of Cristian Vega";
const siteName = "Cristian Vega";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin.origin}/#website`,
      url: `${siteOrigin.origin}/`,
      name: siteName,
      inLanguage: "en",
      publisher: { "@id": `${siteOrigin.origin}/#person` }
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin.origin}/#person`,
      name: siteName,
      url: `${siteOrigin.origin}/`,
      jobTitle: "Senior Director of AI Engineering",
      worksFor: { "@type": "Organization", name: "Patra Corporation" },
      sameAs: ["https://www.linkedin.com/in/cristianvega-ai", "https://github.com/cristianvega-ai"]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      active === "home" && (
        <script is:inline>
          // Stamp before first paint so cold loads never flash readable hero copy
          // then blank it after fonts. No-JS leaves the attribute unset. Must stay
          // aligned with SESSION_KEY / FAILSAFE_DURATION in HeroMotion.astro.
          (function () {
            try {
              if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
              if (sessionStorage.getItem("cristianvega:hero-motion:v1") === "1") return;
              document.documentElement.setAttribute("data-hero-motion-pending", "");
              window.setTimeout(function () {
                document.documentElement.removeAttribute("data-hero-motion-pending");
              }, 3000);
            } catch (_) {
              /* private mode / blocked storage: skip pre-hide */
            }
          })();
        </script>
      )
    }
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F1F3F6" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      ogType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="application/rss+xml" title="Cristian Vega Writing" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <ClientRouter />
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Cristian Vega home">
          <span class="brand__mark">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <g transform="rotate(-24 16 16)">
                <ellipse cx="16" cy="16" rx="12.5" ry="5.2" fill="none" stroke="#828C9C" stroke-width="1.6"></ellipse>
                <circle cx="28.5" cy="16" r="2.5" fill="#F2792B"></circle>
              </g>
              <circle cx="16" cy="16" r="3.3" fill="#F1F3F6"></circle>
            </svg>
          </span>
          <span>Cristian Vega</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a
            class:list={["nav__link", active === "about" && "nav__link--active"]}
            href="/about/"
            aria-current={active === "about" ? "page" : undefined}>about</a
          >
          <a
            class:list={["nav__link", active === "projects" && "nav__link--active"]}
            href="/projects/"
            aria-current={active === "projects" ? "page" : undefined}>projects</a
          >
          <a
            class:list={["nav__link", active === "writing" && "nav__link--active"]}
            href="/writing/"
            aria-current={active === "writing" ? "page" : undefined}>writing</a
          >
          <a
            class:list={["nav__link", active === "contact" && "nav__link--active"]}
            href="/contact/"
            aria-current={active === "contact" ? "page" : undefined}>contact</a
          >
        </nav>
      </div>
    </header>

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    {
      !bare && (
        <footer class="site-footer">
          <div class="wrap site-footer__inner">
            <span class="site-footer__left"><span class="dot"></span> © 2026 · open to talks</span>
            <div class="social">
              <a href="/writing/">writing</a>
              <a href="/rss.xml">rss</a>
              <a href="/sitemap-index.xml">sitemap</a>
            </div>
          </div>
        </footer>
      )
    }
  </body>
</html>
