---
// The frame of every page: the head, the skip link, the one reading column,
// and the analytics beacon. The html element names the page kind and, on a
// detail page, its transition key.
import "../styles/tokens.css";
import "../styles/base.css";
import CloudflareAnalytics from "../components/site/CloudflareAnalytics.astro";
import SiteHead from "../components/site/SiteHead.astro";
import { JOB_TITLE, SITE_NAME, type PageKind } from "../shared/site";

interface Props {
  title?: string;
  description?: string;
  active: PageKind;
  noindex?: boolean;
  published?: string;
  /** The key that pairs this page's heading with its row on a list page. */
  morphKey?: string;
}

const {
  title = `${SITE_NAME} · ${JOB_TITLE}`,
  description = "AI engineering leader building agentic AI and multi-agent platforms for regulated domains, and the engineering organizations that ship them.",
  active,
  noindex = false,
  published,
  morphKey,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-page={active} data-morph-key={morphKey}>
  <head>
    <SiteHead {title} {description} {active} {noindex} {published} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content" class="page" tabindex="-1">
      <slot />
    </main>
    <CloudflareAnalytics />
  </body>
</html>
