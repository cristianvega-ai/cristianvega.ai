---
import "../styles/global.css";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import plexSans400 from "../assets/fonts/ibm-plex-sans-latin-400.woff2?url";
import spaceGrotesk from "../assets/fonts/space-grotesk-latin-600-700.woff2?url";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "error";
  noindex?: boolean;
}

const {
  title = "Cristian Vega · AI Engineering Leader",
  description = "AI engineering leader building agentic AI and multi-agent platforms for regulated domains, and the engineering organizations that ship them.",
  active = "home",
  noindex = false,
} = Astro.props;

const buildYear = new Date().getFullYear();
const pageTitle = title.includes("Cristian Vega") ? title : `${title} · Cristian Vega`;
const siteOrigin = Astro.site ?? new URL("https://cristianvega.ai");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
// Dedicated 1200×630 share card (see scripts/generate-portrait.mjs); not the square master.
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageUrl = new URL("/images/cristian-vega-og.jpg", siteOrigin).toString();
const ogImageAlt = "Portrait of Cristian Vega";
const siteName = "Cristian Vega";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin.origin}/#website`,
      url: `${siteOrigin.origin}/`,
      name: siteName,
      inLanguage: "en",
      publisher: { "@id": `${siteOrigin.origin}/#person` }
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin.origin}/#person`,
      name: siteName,
      url: `${siteOrigin.origin}/`,
      jobTitle: "AI Engineering Leader",
      worksFor: { "@type": "Organization", name: "Vertafore" },
      sameAs: [
        "https://www.linkedin.com/in/cristianvega-ai",
        "https://github.com/cristianvega-ai",
        "https://x.com/cristianvega"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      active === "home" && (
        <script is:inline>
          // Stamp before first paint so cold loads never flash readable hero copy.
          // Release at 1200 ms (PREHIDE_DEADLINE_MS). If the entrance has not
          // started, mark expired so a late module cannot hide the copy.
          // FAILSAFE_DURATION covers a playing run only. No-JS leaves both
          // attributes unset.
          (function () {
            try {
              if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
              if (sessionStorage.getItem("cristianvega:hero-motion:v1") === "1") return;
              document.documentElement.setAttribute("data-hero-motion-pending", "");
              window.setTimeout(function () {
                document.documentElement.removeAttribute("data-hero-motion-pending");
                var hero = document.querySelector(".hero");
                if (!hero || hero.getAttribute("data-motion-state") !== "playing") {
                  document.documentElement.setAttribute("data-hero-motion-expired", "");
                }
              }, 1200);
            } catch (_) {
              /* private mode / blocked storage: skip pre-hide */
            }
          })();
        </script>
      )
    }
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F1F3F6" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* Preload only the faces measurement showed on the critical path: IBM
        Plex Sans 400 roman is the homepage LCP (profile copy), Space Grotesk
        600 is the display heading. Mono 400/500 and Plex Sans 400 italic
        paint later and are left to CSS discovery. crossorigin is required
        for font preloads. */}
    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGrotesk} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Cristian Vega home">
          <span class="brand__mark">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <g transform="rotate(-24 16 16)">
                <ellipse cx="16" cy="16" rx="12.5" ry="5.2" fill="none" stroke="#828C9C" stroke-width="1.6"></ellipse>
                <circle cx="28.5" cy="16" r="2.5" fill="#F2792B"></circle>
              </g>
              <circle cx="16" cy="16" r="3.3" fill="#F1F3F6"></circle>
            </svg>
          </span>
          <span>Cristian Vega</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a class="nav__link" href="https://www.linkedin.com/in/cristianvega-ai" rel="me noopener noreferrer" target="_blank">linkedin</a>
          <a class="nav__link" href="https://x.com/cristianvega" rel="me noopener noreferrer" target="_blank">x</a>
          <a class="nav__link" href="https://github.com/cristianvega-ai" rel="me noopener noreferrer" target="_blank">github</a>
        </nav>
      </div>
    </header>

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="site-footer__disclaimer">
          Disclaimer: The views and opinions expressed on this site are my own.
        </p>
        <p class="site-footer__copyright">© Copyright {buildYear} Cristian Vega</p>
      </div>
    </footer>
    <CloudflareAnalytics />
  </body>
</html>
