---
// The page of one article: the detail frame, the prose, the share links, the
// principles it names, and the neighbouring articles as two quiet rows.
import DetailLayout from "./DetailLayout.astro";
import EntryList from "../components/sections/EntryList.astro";
import { getPrinciples, namedPrinciples, principleRow } from "../shared/content/principles";
import { articleAddress, articleDate, articleMorphKey, articleRow, readingMinutes, type Article } from "../shared/content/writing";
import "../styles/prose.css";
import "../styles/article.css";

interface Props {
  article: Article;
  older?: Article;
  newer?: Article;
}

const { article, older, newer } = Astro.props;
const { title, description, date, topic, series, draft } = article.data;
const shareAddress = new URL(articleAddress(article), Astro.site).href;
const principleRows = namedPrinciples(article.data.principles, await getPrinciples()).map(principleRow);
const neighbours = [newer, older].filter((neighbour): neighbour is Article => Boolean(neighbour)).map((neighbour) => articleRow(neighbour));
---

<DetailLayout
  {title}
  {description}
  lede={description}
  active="article"
  backHref="/writing/"
  backLabel="Writing"
  morphKey={articleMorphKey(article)}
  noindex={draft}
  published={draft ? undefined : date.toISOString()}
  {draft}
  landmark="article"
  class="article"
>
  <Fragment slot="meta">
    <time datetime={date.toISOString().slice(0, 10)}>{articleDate(article)}</time>
    <span>{topic}</span>
    {series && <span>{series}</span>}
    <span>{readingMinutes(article)} min read</span>
  </Fragment>

  <div class="prose"><slot /></div>

  {!draft && (
    <div class="article__share">
      <span>Share</span>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareAddress)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">LinkedIn</a>
      <a href={`https://x.com/intent/post?url=${encodeURIComponent(shareAddress)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
      <button type="button" data-copy-link={shareAddress} hidden>Copy link</button>
      <span class="share-status" role="status"></span>
    </div>
  )}

  {principleRows.length > 0 && (
    <section class="detail__section" aria-labelledby="article-principles">
      <h2 class="detail__section-label" id="article-principles">Principles in this piece</h2>
      <EntryList rows={principleRows} />
    </section>
  )}

  {neighbours.length > 0 && (
    <nav class="detail__section" aria-labelledby="more-writing">
      <h2 class="detail__section-label" id="more-writing">More writing</h2>
      <EntryList rows={neighbours} />
    </nav>
  )}
</DetailLayout>

<script>
  import { setupArticle } from "../browser/article-interactions";

  setupArticle();
</script>
