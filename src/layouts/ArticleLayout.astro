---
import BaseLayout from "./BaseLayout.astro";
import { articleDate, articleAddress, readingMinutes, type Article } from "../shared/writing";
import "../styles/writing.css";

interface Props {
  article: Article;
  older?: Article;
  newer?: Article;
}

const { article, older, newer } = Astro.props;
const shareAddress = new URL(articleAddress(article), Astro.site).href;
---

<BaseLayout title={article.data.title} description={article.data.description} active="article" noindex={article.data.draft} published={article.data.draft ? undefined : article.data.date.toISOString()}>
  <main>
    <article class="article" aria-labelledby="article-title">
      <header class="article__header">
        <div class="article__utility wrap wrap--read">
          <a class="back-link" href="/writing/">← All posts</a>
          {article.data.draft && <p class="article__draft">Draft preview · not published</p>}
        </div>
        <div class="article__header-copy wrap wrap--read">
          <p class={article.data.series ? "eyebrow eyebrow--parts" : "eyebrow"}>{article.data.series ? <><span class="eyebrow__part">{article.data.topic}</span> <span class="eyebrow__part">{article.data.series}</span></> : article.data.topic}</p>
          <h1 id="article-title" class="article__title">{article.data.title}</h1>
          <p class="article__description">{article.data.description}</p>
          <p class="article__metadata"><strong>Cristian Vega</strong><span aria-hidden="true">·</span><time datetime={article.data.date.toISOString().slice(0, 10)}>{articleDate(article)}</time><span aria-hidden="true">·</span><span>{readingMinutes(article)} min read</span></p>
        </div>
        <div class="article__header-rule wrap wrap--read" aria-hidden="true"><span></span><i></i><i></i><i></i></div>
      </header>
      <div class="article__body">
        <div class="prose wrap wrap--read"><slot /></div>
        {!article.data.draft && <div class="wrap wrap--read">
          <div class="author__share">
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareAddress)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">linkedin</a>
            <a href={`https://x.com/intent/post?url=${encodeURIComponent(shareAddress)}&text=${encodeURIComponent(article.data.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">x</a>
            <button type="button" data-copy-link={shareAddress} hidden>copy link</button>
            <span class="share-status" role="status"></span>
          </div>
        </div>}
        {(older || newer) && <nav class="read-next wrap wrap--read" aria-label="More posts">
          {older && <a href={articleAddress(older)}><span>← Older{older.data.draft && " · Draft"}</span><strong>{older.data.title}</strong></a>}
          {newer && <a href={articleAddress(newer)} class="read-next__newer"><span>Newer{newer.data.draft && " · Draft"} →</span><strong>{newer.data.title}</strong></a>}
        </nav>}
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  import { setupArticle } from "../shared/article-interactions";

  setupArticle();
</script>
