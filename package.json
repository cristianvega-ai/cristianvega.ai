{
  "name": "cristianvega-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve:development": "astro dev",
    "serve:production": "wrangler dev --local",
    "build": "node scripts/check-public-system-files.mjs && astro build",
    "check": "astro check",
    "test": "npm run build && npm run test:node && npm run test:end-to-end",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:property": "node --test tests/property/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:node": "node --test tests/unit/*.test.mjs tests/property/*.test.mjs tests/integration/*.test.mjs",
    "test:end-to-end": "playwright test",
    "verify":"npm run build && npm run check && npm run test:node && npm run test:end-to-end",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "generate:social-preview": "node scripts/generate-social-preview.mjs",
    "generate:touch-icon": "node scripts/generate-touch-icon.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "js-yaml": "^5.4.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "$sharp"
    }
  }
}
