{
  "name": "cristianvega-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-public.mjs",
    "build": "astro build",
    "preview": "wrangler dev --local",
    "check": "astro check",
    "test:run": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:run",
    "verify": "npm run build && npm run check && npm run test:run && npm run test:e2e",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "generate:portrait": "node scripts/generate-portrait.mjs",
    "generate:touch-icon": "node scripts/generate-touch-icon.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "4.144.0"
  }
}
