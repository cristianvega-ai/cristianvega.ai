# Security headers apply to every static response, including the 404 page.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-DarllRtSZBmSvCjf89jdetABo5/SYKGdWIWRem+vzIs='; connect-src 'self' https://cristianvegaai.goatcounter.com; upgrade-insecure-requests

# HTML must match the build. Prevent automatic analytics script injection.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/404/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Hashed assets can stay cached. Stable URLs need shorter lifetimes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Test addresses must not appear in search results.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
