# DreamHost (Apache) configuration for cristianvega.ai
# Copied into dist/ on build via the public/ directory.

# Never serve directory listings for /images/, /_astro/ or /posts/
Options -Indexes

# HTTPS + apex host in one hop each.
# www must resolve in DNS (CNAME or A to the same host as the apex) and the
# TLS cert SAN must cover www; otherwise this rule is unreachable.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host first: http(s)://www → https://apex (single 301)
  RewriteCond %{HTTP_HOST} ^www\.cristianvega\.ai$ [NC]
  RewriteRule ^ https://cristianvega.ai%{REQUEST_URI} [L,R=301]

  # Force HTTPS, always onto the canonical apex so no Host header this vhost
  # receives is reflected back into a redirect target.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://cristianvega.ai%{REQUEST_URI} [L,R=301]

  # Retired pages. The profile they held is now on the home page, and both URLs
  # were public and indexed, so they redirect instead of returning 404.
  RewriteRule ^about/?$ / [L,R=301]
  RewriteRule ^contact/?$ / [L,R=301]
</IfModule>

# Security headers (best-effort; requires mod_headers)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # One-year HSTS on this host only. Omit includeSubDomains: ftp.cristianvega.ai
  # is live and does not present a valid HTTPS certificate.
  Header always set Strict-Transport-Security "max-age=31536000"
  # CSP matched to current static build: self-hosted assets, data: favicon.
  # Fonts are hashed files under /_astro/, so font-src stays 'self'. Bundled
  # scripts are external same-origin modules; the one inline script (the
  # homepage hero pre-hide stamp in BaseLayout.astro) is allowed by hash,
  # never by 'unsafe-inline'. tests/security.test.mjs recomputes the hash
  # from dist/ so an edit to that script fails the gate.
  # style-src keeps 'unsafe-inline' for Astro inlineStylesheets: 'auto'.
  # connect-src also lists the GoatCounter endpoint host, which receives the
  # pageview beacon. The count script is self-hosted at /js/count.v5.js, so
  # script-src gains no analytics host.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-XAmQDOZkZmpTCL+kRJn5V0l3aQGa2/ZQ/miN4MqFqnI='; connect-src 'self' https://cristianvegaai.goatcounter.com; upgrade-insecure-requests"
</IfModule>

# Custom 404 (Astro emits 404.html for static hosts)
ErrorDocument 404 /404.html

# Caching: hashed /_astro/* is immutable. Stable /images/* revalidates so
# portrait regenerations are not pinned for a year. Stable /js/* uses a
# one-hour lifetime so analytics updates are not pinned. HTML always
# revalidates. Path scoping uses Apache 2.4 <If> (LocationMatch is not
# valid in .htaccess).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Compress the text assets this build ships (no-op if the host already does)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </If>
  <If "%{REQUEST_URI} =~ m#^/js/#">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </If>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
