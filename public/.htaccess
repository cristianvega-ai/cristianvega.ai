# DreamHost (Apache) configuration for cristianvega.ai
# Copied into dist/ on build via the public/ directory.

# Never serve directory listings for /images/, /_astro/ or /posts/
Options -Indexes

# HTTPS + apex host in one hop each.
# www must resolve in DNS (CNAME or A to the same host as the apex) and the
# TLS cert SAN must cover www; otherwise this rule is unreachable.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host first: http(s)://www → https://apex (single 301)
  RewriteCond %{HTTP_HOST} ^www\.cristianvega\.ai$ [NC]
  RewriteRule ^ https://cristianvega.ai%{REQUEST_URI} [L,R=301]

  # Force HTTPS, always onto the canonical apex so no Host header this vhost
  # receives is reflected back into a redirect target.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://cristianvega.ai%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers (best-effort; requires mod_headers)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS bootstrap: short, reversible, apex-only. After HTTPS and the cert SAN
  # list are confirmed on the live origin, raise to max-age=31536000; includeSubDomains.
  Header always set Strict-Transport-Security "max-age=300"
  # CSP matched to current static build: self-hosted assets, Google Fonts,
  # data: favicon. Bundled scripts are external same-origin modules; the one
  # inline script (the homepage hero pre-hide stamp in BaseLayout.astro) is
  # allowed by hash, never by 'unsafe-inline'. tests/site.test.mjs recomputes
  # the hash from dist/ so an edit to that script fails the gate.
  # style-src keeps 'unsafe-inline' for Astro inlineStylesheets: 'auto'.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-XAmQDOZkZmpTCL+kRJn5V0l3aQGa2/ZQ/miN4MqFqnI='; connect-src 'self'; upgrade-insecure-requests"
</IfModule>

# Custom 404 (Astro emits 404.html for static hosts)
ErrorDocument 404 /404.html

# Caching: hashed /_astro/* is immutable; stable /images/* revalidates so
# portrait regenerations are not pinned for a year. HTML always revalidates.
# Path scoping uses Apache 2.4 <If> (LocationMatch is not valid in .htaccess).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/avif "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
</IfModule>

# Compress the text assets this build ships (no-op if the host already does)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </If>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
